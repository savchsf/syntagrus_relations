{
    "exp_dir": "exp",
    "dataset_path": "dataset/ru_syntagrus-ud-train-a.conllu",
    "max_sentences":600,

    "n_predictors":3,
    "do_sort_bin":true,

    "batch_size":3000,
    "batch_sentence":400,
    "use_bert": true,
    "bert_name":"sergeyzh/rubert-mini-uncased",
    "unk_token":"_",
    "use_head":true,
    "predict_head":true,
    "use_pos":true,
    "use_morph":true,
    "use_sentenceemb":true,
    "use_distance":true,
    "use_s_no":true,
    "binary":false,


    "scaler":"MinMaxScaler",
    "methods":[
                "NearMiss3","TomekLinks","RandomOversampling"
            ],

    "test_size":0.3,
    "k":2,

    "model":"SVM",

    "stages":[
            "1","2","3","4"
    ]

}
