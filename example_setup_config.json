{
    "exp_dir": "train_a",
    "dataset_path": "dataset/ru_syntagrus-ud-train-a.conllu",
    "max_sentences":500,

    "n_predictors":3,
    "do_sort_bin":true,

    "batch_size":2500,
    "batch_sentence":300,
    "use_bert": true,
    "bert_name":"sergeyzh/rubert-mini-uncased",
    "unk_token":"_",
    "use_head":true,
    "predict_head":true,
    "use_pos":true,
    "use_morph":true,
    "use_sentenceemb":true,
    "use_distance":true,
    "use_s_no":true,
    "binary":false,
    "strip_colon": true,
    "ignored": ["list","parataxis","dislocated","orphan","dep","punct"],


    "scaler":"MinMaxScaler",
    "methods":[
                "NearMiss3","TomekLinks","RandomOversampling"
            ],

    "test_size":0.1,
    "k":2,

    "model":"SVM",
    "zero_threshold":0.1,
    "stages":[
            "2","3","4"
    ]

}
